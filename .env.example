# DO NOT PUT SECRETS IN THIS FILE.
# Copy this template to `.env` and fill in your keys with:
#
#   cp -n .env.example .env
#
# `.env` is gitignored.

# Provider API keys: uncomment the ones you use.
# `.env` is loaded with override=True, so an uncommented empty line
# (e.g. `OPENAI_API_KEY=`) blanks out a key exported in your shell.
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=

# Key for the vLLM server on Modal (the `vllm-api-key` Modal secret). Configs read it
# as ${VLLM_API_KEY}. Don't set VLLM_BASE_URL here.
# VLLM_API_KEY=

# The DCOP environments need a CoLLAB checkout. Running from the repo root finds
# the `external/CoLLAB` submodule automatically. For a checkout elsewhere, set:
# TERRARIUM_COLLAB_PATH=/path/to/CoLLAB
